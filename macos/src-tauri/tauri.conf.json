{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FRAME Ebook",
  "version": "0.3.3",
  "identifier": "com.kimkingv2.frameebook",
  "build": {
    "frontendDist": "../../pages"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FRAME Ebook",
        "url": "mac/index.html",
        "width": 1320,
        "height": 900,
        "minWidth": 980,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CACHE/**"
        ]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "category": "Reference",
    "shortDescription": "Local-first WebDAV EPUB reader",
    "longDescription": "FRAME Ebook is a local-first macOS reader for EPUB and CBZ books stored on WebDAV.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
